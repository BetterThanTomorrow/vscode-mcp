{:paths ["scripts"]
 :deps {org.babashka/cli {:mvn/version "0.8.66"}}
 :tasks
 {:requires ([babashka.cli :as cli]
             [babashka.process :refer [shell]]
             [vendor-jsonc-parser]
             [watch-registry])

  test-bb
  {:doc "Run Babashka tests for listing scripts (mcp.clj)."
   :extra-paths ["assets/registry-content/scripts" "test-bb"]
   :requires ([clojure.test :as t]
              [mcp-test])
   :task (let [{:keys [fail error]} (t/run-tests 'mcp-test)]
           (when (pos? (+ fail error))
             (System/exit 1)))}

  test
  {:doc "Compiles and runs unit tests."
   :task (do
           (shell "clojure -M:shadow-cljs compile test")
           (shell "node out/test.js")
           (run 'test-bb))}

  vendor-jsonc-parser
  {:doc "Bundle microsoft/jsonc-parser into src/vscode_mcp/vendor/jsonc_parser.js [--version <ver>]"
   :task (vendor-jsonc-parser/vendor!
          (cli/parse-opts *command-line-args* vendor-jsonc-parser/cli-spec))}

  watch-registry
  {:doc "Watch MCP window shards (consumer view). Terse log to .tmp/registry-watch.log [--verbose EDN]"
   :task (watch-registry/main! *command-line-args*)}}}
